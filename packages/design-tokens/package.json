{
  "name": "@somenergia/design-tokens",
  "version": "1.0.0",
  "description": "Som Energia design tokens: colors, typography, radii and spacing as JS and CSS custom properties",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Som-Energia/somenergia-design#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Som-Energia/somenergia-design.git"
  },
  "bugs": {
    "url": "https://github.com/Som-Energia/somenergia-design/issues"
  },
  "keywords": [
    "somenergia",
    "design-tokens",
    "css-variables",
    "design-system"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src/index.js",
    "dist"
  ],
  "exports": {
    ".": "./src/index.js",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "node scripts/build-css.js",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint ./src ./scripts",
    "lint:fix": "eslint ./src ./scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@somenergia/frontend-config": "github:Som-Energia/frontend-config#v1.1.2",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "npm": ">=11.0.0 <12.0.0",
    "node": ">=24.0.0 <25.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
