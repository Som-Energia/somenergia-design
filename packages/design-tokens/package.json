{
  "name": "@somenergia/design-tokens",
  "version": "1.0.1",
  "description": "Som Energia design tokens: colors, typography, radii and spacing as JS and CSS custom properties",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Som-Energia/somenergia-design#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Som-Energia/somenergia-design.git",
    "directory": "packages/design-tokens"
  },
  "bugs": {
    "url": "https://github.com/Som-Energia/somenergia-design/issues"
  },
  "keywords": [
    "somenergia",
    "design-tokens",
    "css-variables",
    "design-system"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src/index.js",
    "dist",
    "docs/consumer-guide.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run build:tokens && npm run build:types",
    "build:tokens": "node scripts/build-css.js",
    "build:types": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:ci": "vitest run && npm run test:types",
    "test:types": "npm run build:types && tsc -p types-test/tsconfig.json",
    "lint": "eslint ./src ./scripts",
    "lint:fix": "eslint ./src ./scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@somenergia/frontend-config": "github:Som-Energia/frontend-config#v1.1.2",
    "eslint": "9.39.4",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "npm": ">=11.0.0 <12.0.0",
    "node": ">=24.0.0 <25.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
